rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Games — anyone can read listed games; only admins can write
    match /games/{gameId} {
      allow read: if request.auth != null && (resource.data.listed == true || isAdmin());
      allow write: if isAdmin();
    }
    // Referee docs — owner or admin
    match /referees/{uid} {
      allow read, write: if request.auth.uid == uid || isAdmin();
    }
    // Admins collection — only admins can read/write
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // managed in Firebase console only
    }
  }
}
